FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY services services
RUN useradd --uid 10001 --create-home appuser \
    && mkdir -p /app/.private /app/.secrets \
    && chown appuser:appuser /app/.private /app/.secrets \
    && chmod 700 /app/.private /app/.secrets
USER appuser
ENV SERVICE=ingestion PORT=8080
CMD ["sh", "-c", "exec uvicorn services.${SERVICE}.main:app --host 0.0.0.0 --port ${PORT} --no-access-log"]
